+/* dd1: frame limit, see patch_ring.py */
+static uint64_t dd1FrameNs = UINT64_MAX;
+static uint64_t dd1NextFrame = 0;
+
+static void dd1PaceFrame(void) {
+    if (dd1FrameNs == UINT64_MAX) {
+        const char* value = getenv("DD1_FPS_LIMIT");
+        int fps = value ? atoi(value) : 60;
+        dd1FrameNs = fps > 0 ? 1000000000ULL / fps : 0;
+    }
+    if (dd1FrameNs == 0) return;
+
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    uint64_t now = (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+    if (dd1NextFrame > now) {
+        ts.tv_sec = dd1NextFrame / 1000000000ULL;
+        ts.tv_nsec = dd1NextFrame % 1000000000ULL;
+        while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR);
+        dd1NextFrame += dd1FrameNs;
+    }
+    /* late by less than a frame: keep the cadence; later: start again from now */
+    else if (now - dd1NextFrame < dd1FrameNs) dd1NextFrame += dd1FrameNs;
+    else dd1NextFrame = now + dd1FrameNs;
+}

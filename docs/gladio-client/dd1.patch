+/* dd1: uniform and attribute locations do not change until the program is
+ * linked again, but every query was a round trip to the renderer - 71% of the
+ * game's main thread on a Galaxy S26 Ultra (Darkest Dungeon asks every frame).
+ * Remembered per context, program and name; a link or a delete of the program
+ * forgets its entries. */
+typedef struct LocationCacheEntry {
+    GLContext* context;
+    GLuint program;
+    bool attrib;
+    GLint location;
+    char* name;
+} LocationCacheEntry;
+
+static LocationCacheEntry* locationCache = NULL;
+static int locationCacheCapacity = 0;
+static int locationCacheCount = 0;
+
+static unsigned int locationHash(GLContext* context, GLuint program, bool attrib, const char* name) {
+    unsigned int h = 2166136261u ^ (unsigned int)(uintptr_t)context ^ (program * 16777619u) ^ (attrib ? 0x9e3779b9u : 0u);
+    for (const unsigned char* c = (const unsigned char*)name; *c; c++) h = (h ^ *c) * 16777619u;
+    return h;
+}
+
+static LocationCacheEntry* locationCacheFind(GLuint program, bool attrib, const char* name, bool* found) {
+    *found = false;
+    if (locationCacheCapacity == 0) return NULL;
+    unsigned int i = locationHash(currentGLContext, program, attrib, name) & (locationCacheCapacity - 1);
+    while (locationCache[i].name) {
+        LocationCacheEntry* e = &locationCache[i];
+        if (e->context == currentGLContext && e->program == program && e->attrib == attrib && strcmp(e->name, name) == 0) {
+            *found = true;
+            return e;
+        }
+        i = (i + 1) & (locationCacheCapacity - 1);
+    }
+    return &locationCache[i];
+}
+
+static void locationCacheRebuild(int capacity, bool dropProgram, GLuint program) {
+    LocationCacheEntry* old = locationCache;
+    int oldCapacity = locationCacheCapacity;
+    locationCacheCapacity = capacity;
+    locationCache = calloc(locationCacheCapacity, sizeof(LocationCacheEntry));
+    locationCacheCount = 0;
+    for (int i = 0; i < oldCapacity; i++) {
+        if (!old[i].name) continue;
+        if (dropProgram && old[i].program == program) {
+            free(old[i].name);
+            continue;
+        }
+        unsigned int j = locationHash(old[i].context, old[i].program, old[i].attrib, old[i].name) & (locationCacheCapacity - 1);
+        while (locationCache[j].name) j = (j + 1) & (locationCacheCapacity - 1);
+        locationCache[j] = old[i];
+        locationCacheCount++;
+    }
+    free(old);
+}
+
+static void locationCachePut(GLuint program, bool attrib, const char* name, GLint location) {
+    if ((locationCacheCount + 1) * 2 > locationCacheCapacity)
+        locationCacheRebuild(locationCacheCapacity ? locationCacheCapacity * 2 : 1024, false, 0);
+    bool found;
+    LocationCacheEntry* e = locationCacheFind(program, attrib, name, &found);
+    if (found) {
+        e->location = location;
+        return;
+    }
+    e->context = currentGLContext;
+    e->program = program;
+    e->attrib = attrib;
+    e->location = location;
+    e->name = strdup(name);
+    locationCacheCount++;
+}
+
+/* Rebuilt without the program's entries: open addressing cannot blank slots
+ * out of the middle of a probe chain. */
+static void locationCacheForget(GLuint program) {
+    if (locationCacheCount == 0) return;
+    locationCacheRebuild(locationCacheCapacity, true, program);
+}

<?xml version="1.0" encoding="utf-8"?>
<!-- The same shape as the home screen: what you act on down the left, what it is
     doing down the right. A slot card stretched across the whole width read as
     one enormous row and left nowhere for progress to go. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- The header sits inside the left column, the way the home screen has it,
         so the log panel starts level with the title instead of under it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"
            android:orientation="vertical">

            <include layout="@layout/dd1_screen_header" />

            <ProgressBar
                android:id="@+id/PBSavesLoading"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Said once above the list rather than in every card: with ten
                 slots the labels would be the loudest thing on the screen. -->
            <LinearLayout
                android:id="@+id/LLSlotHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- The same width the slot's name takes in a row, so the two
                     labels sit over the two boxes. -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="1dp" />

                <TextView
                    style="@style/DD1SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:paddingStart="10dp"
                    android:text="@string/dd1_saves_local" />

                <TextView
                    style="@style/DD1SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="10dp"
                    android:text="@string/dd1_saves_cloud" />
            </LinearLayout>

            <!-- The slots scroll on their own so that ten of them cannot push the
                 snapshots off the bottom of the screen. The minimum is two rows:
                 a slot cut in half reads as a rendering fault. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">

                <LinearLayout
                    android:id="@+id/LLSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                style="@style/DD1SectionTitle"
                android:layout_marginTop="12dp"
                android:text="@string/dd1_saves_snapshots" />

            <!-- Shared by weight rather than capped: maxHeight is not an attribute
                 a ScrollView honours, so asking for one silently gave the
                 snapshots the whole foot of the screen and cut a slot in half. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2">

                <LinearLayout
                    android:id="@+id/LLSnapshots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <ScrollView
            android:id="@+id/SVSavesLog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="55"
            android:layout_marginStart="12dp"
            android:background="?attr/colorSecondarySurface"
            android:scrollbars="vertical">

            <!-- The padding belongs to the text, not the viewport, or the last
                 line never comes fully into view. -->
            <TextView
                android:id="@+id/TVSavesLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="?attr/colorSecondaryText"
                android:textIsSelectable="true"
                android:textSize="@dimen/dd1_log_size" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>

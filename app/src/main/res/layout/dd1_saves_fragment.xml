<?xml version="1.0" encoding="utf-8"?>
<!-- One save at a time, large, on the left; every save on the right by name,
     with a light for where it stands. Snapshots are their own tab, and the
     transfer log waits behind a button: a slot-per-row table needed scrolling
     past four saves and named them profile_N, which nobody playing knows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/dd1_screen_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/BTSavesTabManage"
            style="@style/DD1Tab"
            android:layout_marginStart="20dp"
            android:text="@string/dd1_saves_tab_manage" />

        <TextView
            android:id="@+id/BTSavesTabSnapshots"
            style="@style/DD1Tab"
            android:text="@string/dd1_saves_snapshots" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/BTSavesRefresh"
            style="@style/DD1Action"
            android:text="@string/dd1_saves_refresh" />

        <Button
            android:id="@+id/BTSavesLog"
            style="@style/DD1Action"
            android:text="@string/dd1_saves_log" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSecondarySurface" />

    <!-- Manage: the chosen save, and the list. -->
    <LinearLayout
        android:id="@+id/LLSavesManage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="62"
            android:background="@drawable/dd1_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/PBSavesLoading"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/TVSavesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorSecondaryText"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/LLSaveDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/TVSaveTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/colorPrimaryText"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/TVSaveState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp" />
                    </LinearLayout>


                    <!-- Its room is kept whether or not anything moves, so the save
                         below it never jumps: idle it holds the last outcome, busy
                         the step and the bar. -->
                    <LinearLayout
                        android:id="@+id/LLSavesStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TVSavesStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="?attr/colorSecondaryText"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/PBSavesTransfer"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/dd1_box_outline"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/DD1SectionTitle"
                                android:layout_marginTop="0dp"
                                android:text="@string/dd1_saves_local" />

                            <TextView
                                android:id="@+id/TVSaveLocal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="?attr/colorPrimaryText"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/dd1_box_outline"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/DD1SectionTitle"
                                android:layout_marginTop="0dp"
                                android:text="@string/dd1_saves_cloud" />

                            <TextView
                                android:id="@+id/TVSaveCloud"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="?attr/colorPrimaryText"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            style="@style/DD1Button"
                            android:id="@+id/BTSaveUpload"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/dd1_saves_upload" />

                        <Button
                            style="@style/DD1Button"
                            android:id="@+id/BTSaveDownload"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/dd1_saves_download" />

                        <Button
                            android:id="@+id/BTSaveDelete"
                            style="@style/DD1Action"
                            android:layout_marginStart="8dp"
                            android:text="@string/dd1_saves_delete_short"
                            android:textColor="@color/dd1_danger" />
                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="38"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/DD1SectionTitle"
                android:layout_marginTop="0dp"
                android:text="@string/dd1_saves_list" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/LLSaveList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/TVSaveLegend"
                style="@style/DD1Meta"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Snapshots: taken before every transfer, and a copy to storage. -->
    <LinearLayout
        android:id="@+id/LLSavesSnapshotsTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/DD1Meta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/dd1_saves_snapshots_hint" />

            <Button
                android:id="@+id/BTSaveBackup"
                style="@style/DD1Action"
                android:text="@string/dd1_saves_backup" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/LLSnapshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>

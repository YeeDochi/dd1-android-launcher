<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <include layout="@layout/dd1_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_language" />

            <RadioGroup
                android:id="@+id/RGLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_resolution" />

            <RadioGroup
                android:id="@+id/RGResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/TVResolutionHint"
                style="@style/DD1Meta"
                android:layout_marginTop="8dp"
                android:text="@string/dd1_resolution_hint" />

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_performance" />

            <CheckBox
                android:id="@+id/CBBox64Performance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dd1_box64_performance" />

            <TextView
                android:id="@+id/TVBox64Hint"
                style="@style/DD1Meta"
                android:text="@string/dd1_box64_performance_hint" />

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_cpu_budget" />

            <RadioGroup
                android:id="@+id/RGCpuBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/TVCpuBudgetHint"
                style="@style/DD1Meta"
                android:text="@string/dd1_cpu_budget_hint" />

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_refresh_rate" />

            <RadioGroup
                android:id="@+id/RGRefreshRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/TVRefreshRateHint"
                style="@style/DD1Meta"
                android:text="@string/dd1_refresh_rate_hint" />

            <TextView
                style="@style/DD1SectionTitle"
                android:text="@string/dd1_open_source" />

            <TextView
                android:id="@+id/TVOpenSource"
                style="@style/DD1Meta"
                android:layout_marginTop="4dp"
                android:text="@string/dd1_open_source_notice" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

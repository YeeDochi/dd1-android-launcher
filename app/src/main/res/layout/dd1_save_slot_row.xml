<?xml version="1.0" encoding="utf-8"?>
<!-- One slot: its name, then a box per side. The boxes are the buttons - a box
     you press is its own boundary, where two columns of text with a link under
     each read as one undivided thing. The arrow says which way pressing it
     moves the save: up out of this device, down out of the cloud. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/TVSlotName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/LLSlotLocal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/colorSecondarySurface"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/TVSlotLocalArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="↑"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/TVSlotLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLSlotCloud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:background="?attr/colorSecondarySurface"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/TVSlotCloudArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="↓"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/TVSlotCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/DLDD1Drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/FLDD1Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorPrimarySurface" />

    <LinearLayout
        android:id="@+id/LLDD1Drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSecondarySurface"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/dd1_app_name"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTDrawerDlc"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:text="@string/dd1_dlc"
            android:textColor="?attr/colorPrimaryText" />

        <Button
            android:id="@+id/BTDrawerSaves"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:text="@string/dd1_saves"
            android:textColor="?attr/colorPrimaryText" />

        <Button
            android:id="@+id/BTDrawerWorkshop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:text="@string/dd1_workshop"
            android:textColor="?attr/colorPrimaryText" />

        <Button
            android:id="@+id/BTDrawerSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:text="@string/dd1_settings"
            android:textColor="?attr/colorPrimaryText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/BTDrawerAbout"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:text="@string/dd1_open_source_info"
            android:textColor="?attr/colorSecondaryText" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

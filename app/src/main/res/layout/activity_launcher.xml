<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F2E8D5"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/payload_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/payload_missing"
        android:textColor="#D3C7B4"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/runtime_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/runtime_not_ready"
        android:textColor="#D3C7B4"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/launch_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/launch_not_started"
        android:textColor="#D3C7B4"
        android:textSize="16sp" />
</LinearLayout>

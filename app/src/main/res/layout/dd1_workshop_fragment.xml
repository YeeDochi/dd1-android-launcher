<?xml version="1.0" encoding="utf-8"?>
<!-- A phone in landscape has about 360dp of height. The way back, the title and
     the two tabs share one row, and each tab's controls share the next, so the
     list starts a third of the way down instead of past the middle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/BTScreenBack" android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/dd1_back" android:gravity="center"
            android:text="‹" android:textColor="?attr/colorSecondaryText"
            android:textSize="28sp" />
        <TextView android:id="@+id/TVScreenTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:layout_marginEnd="20dp" android:textColor="?attr/colorPrimaryText"
            android:textSize="@dimen/dd1_title_size" android:textStyle="bold" />
        <TextView android:id="@+id/BTWorkshopTabStore" style="@style/DD1Tab"
            android:text="@string/dd1_workshop_tab_store" />
        <TextView android:id="@+id/BTWorkshopTabInstalled" style="@style/DD1Tab"
            android:text="@string/dd1_workshop_tab_installed" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/colorSecondarySurface" />

    <LinearLayout android:id="@+id/LLWorkshopStore" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/TIWorkshopSearch" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="@string/dd1_workshop_search_hint" android:imeOptions="actionSearch"
                android:inputType="text" android:maxLines="1" android:textSize="14sp"
                android:textColor="?attr/colorPrimaryText"
                android:textColorHint="?attr/colorSecondaryText" />
            <Button android:id="@+id/BTWorkshopSearch" style="@style/DD1Action"
                android:text="@string/dd1_workshop_search" />
            <Spinner android:id="@+id/SPWorkshopSort" android:layout_width="wrap_content"
                android:layout_height="44dp" android:layout_marginStart="4dp" />
            <Button android:id="@+id/BTWorkshopRefresh" style="@style/DD1Action"
                android:text="@string/dd1_workshop_refresh" />
        </LinearLayout>
        <TextView android:id="@+id/TVWorkshopStoreMessage" style="@style/DD1Meta"
            android:padding="8dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/PBWorkshopLoading"
            style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true"
            android:visibility="gone" />
        <!-- Shown from the moment the screen opens: the store is only asked for
             once Steam has listed the subscriptions, which takes seconds, and an
             empty screen in the meantime reads as nothing being there. -->
        <ProgressBar android:id="@+id/PBWorkshopStoreSpinner"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="64dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <GridLayout android:id="@+id/GLWorkshopCards" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:alignmentMode="alignMargins"
                    android:columnCount="2" android:useDefaultMargins="false" />
                <Button android:id="@+id/BTWorkshopMore" style="@style/DD1Action"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/dd1_workshop_more" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/LLWorkshopInstalled" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:visibility="gone">
        <!-- What is installed, at a glance, and the one thing worth doing about
             it. Importing and asking again are secondary and look it. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical"
            android:minHeight="44dp" android:orientation="horizontal">
            <TextView android:id="@+id/TVWorkshopSummary" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="?attr/colorPrimaryText" android:textSize="15sp" />
            <Button android:id="@+id/BTWorkshopImport" style="@style/DD1Action"
                android:text="@string/dd1_workshop_import" />
            <Button android:id="@+id/BTWorkshopInstalledRefresh" style="@style/DD1Action"
                android:text="@string/dd1_workshop_refresh" />
            <Button android:id="@+id/BTWorkshopSync" android:layout_width="wrap_content"
                android:layout_height="40dp" android:layout_marginStart="8dp"
                android:text="@string/dd1_workshop_sync" android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="?attr/colorSecondarySurface"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp">
            <TextView android:id="@+id/TVWorkshopDropFolder" style="@style/DD1Meta"
                android:layout_width="0dp" android:layout_weight="1" />
            <Button android:id="@+id/BTWorkshopDropFolder" style="@style/DD1Action" />
        </LinearLayout>
        <ProgressBar android:id="@+id/PBWorkshopProgress"
            style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/TVWorkshopMessage" style="@style/DD1Meta"
            android:padding="8dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/PBWorkshopInstalledSpinner"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="64dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/TVWorkshopLocalHeading" style="@style/DD1SectionTitle"
                    android:layout_marginTop="12dp" android:text="@string/dd1_workshop_heading_local"
                    android:visibility="gone" />
                <LinearLayout android:id="@+id/LLWorkshopLocalList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView android:id="@+id/TVWorkshopSteamHeading" style="@style/DD1SectionTitle"
                    android:layout_marginTop="12dp" android:text="@string/dd1_workshop_heading_steam"
                    android:visibility="gone" />
                <LinearLayout android:id="@+id/LLWorkshopList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

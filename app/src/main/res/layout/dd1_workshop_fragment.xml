<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/dd1_screen_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTWorkshopRefresh"
                style="@style/DD1Action"
                android:text="@string/dd1_workshop_refresh" />

            <Button
                android:id="@+id/BTWorkshopSync"
                style="@style/DD1Action"
                android:layout_marginStart="16dp"
                android:text="@string/dd1_workshop_sync"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/PBWorkshopLoading"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/PBWorkshopProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/TVWorkshopMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="?attr/colorSecondaryText"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/LLWorkshopList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/SVWorkshopLog"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:background="?attr/colorSecondarySurface">

        <TextView
            android:id="@+id/TVWorkshopLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="?attr/colorSecondaryText"
            android:textIsSelectable="true"
            android:textSize="@dimen/dd1_log_size" />
    </ScrollView>
</LinearLayout>

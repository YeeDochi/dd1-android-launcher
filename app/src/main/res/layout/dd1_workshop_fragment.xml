<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <include layout="@layout/dd1_screen_header" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/BTWorkshopTabStore" style="@style/DD1Action"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/dd1_workshop_tab_store" />
        <Button android:id="@+id/BTWorkshopTabInstalled" style="@style/DD1Action"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/dd1_workshop_tab_installed" />
    </LinearLayout>

    <LinearLayout android:id="@+id/LLWorkshopStore" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/TIWorkshopSearch" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="@string/dd1_workshop_search_hint" android:imeOptions="actionSearch"
                android:inputType="text" android:maxLines="1"
                android:textColor="?attr/colorPrimaryText"
                android:textColorHint="?attr/colorSecondaryText" />
            <Button android:id="@+id/BTWorkshopSearch" style="@style/DD1Action"
                android:layout_width="96dp" android:layout_marginStart="8dp"
                android:text="@string/dd1_workshop_search" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <Spinner android:id="@+id/SPWorkshopSort" android:layout_width="wrap_content"
                android:layout_height="48dp" />
            <Button android:id="@+id/BTWorkshopRefresh" style="@style/DD1Action"
                android:layout_marginStart="12dp" android:text="@string/dd1_workshop_refresh" />
        </LinearLayout>
        <TextView android:id="@+id/TVWorkshopStoreMessage" style="@style/DD1Meta"
            android:padding="8dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/PBWorkshopLoading"
            style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true"
            android:visibility="gone" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <GridLayout android:id="@+id/GLWorkshopCards" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:alignmentMode="alignMargins"
                android:columnCount="2" android:useDefaultMargins="false" />
        </ScrollView>
        <Button android:id="@+id/BTWorkshopMore" style="@style/DD1Action"
            android:layout_gravity="center_horizontal" android:text="@string/dd1_workshop_more"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/LLWorkshopInstalled" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:visibility="gone">
        <Button android:id="@+id/BTWorkshopSync" style="@style/DD1Action"
            android:text="@string/dd1_workshop_sync" android:visibility="gone" />
        <ProgressBar android:id="@+id/PBWorkshopProgress"
            style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/TVWorkshopMessage" style="@style/DD1Meta"
            android:padding="8dp" android:visibility="gone" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:id="@+id/LLWorkshopList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>

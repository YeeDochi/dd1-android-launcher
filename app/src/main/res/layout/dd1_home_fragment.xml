<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is placed by weight. A phone in landscape is about 380dp wide
     and a tablet surface nearly twice that, so fixed margins that look right on
     one are wrong on the other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="92"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="38"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/BTMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dd1_menu"
                android:src="@drawable/icon_action_bar_menu" />

            <!-- Autosize truncates rather than shrinks when the width comes
                 from a weight, so the size comes from the screen bucket. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dd1_app_name"
                android:textColor="?attr/colorPrimaryText"
                android:textSize="@dimen/dd1_title_size"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dd1_home_subtitle"
            android:textColor="?attr/colorSecondaryText"
            android:textSize="14sp" />

        <!-- The status box and the actions read as one block. It sits a little
             above the middle of what the header leaves: dead centre reads as
             sagging with the title pinned to the top. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4" />

            <TextView
                android:id="@+id/TVStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="?attr/colorSecondarySurface"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="?attr/colorPrimaryText"
                android:textSize="15sp" />

            <Button
                android:id="@+id/BTPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/dd1_play" />

            <Button
                android:id="@+id/BTCancelSignIn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:gravity="start|center_vertical"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="@string/dd1_steam_cancel_sign_in"
                android:textColor="?attr/colorPrimaryText"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTSignOutAlways"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:gravity="start|center_vertical"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="@string/dd1_steam_sign_out"
                android:textColor="?attr/colorSecondaryText"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTDeleteGame"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:gravity="start|center_vertical"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="@string/dd1_delete_game"
                android:textColor="?attr/colorSecondaryText"
                android:visibility="gone" />


            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="49"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/LLSteamInstall"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:minHeight="0dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/IVSteamQr"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/dd1_steam_qr"
                android:visibility="gone" />

            <EditText
                android:id="@+id/ETSteamAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/dd1_steam_account"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="?attr/colorPrimaryText"
                android:textColorHint="?attr/colorSecondaryText"
                android:visibility="gone" />

            <EditText
                android:id="@+id/ETSteamPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/dd1_steam_password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="?attr/colorPrimaryText"
                android:textColorHint="?attr/colorSecondaryText"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTSteamCredentials"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/dd1_steam_credentials"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTSteamLogin"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/dd1_steam_login"
                android:textColor="?attr/colorPrimaryText"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTDownload"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/dd1_download"
                android:visibility="gone" />

            <TextView
                android:id="@+id/TVDlcTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dd1_dlc"
                android:textColor="?attr/colorSecondaryText"
                android:textSize="13sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/SVDlcChoices"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/LLDlcChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/LLDownloadBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/PBDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:max="1000" />

                <TextView
                    android:id="@+id/TVDownloadPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorPrimaryText"
                    android:textSize="14sp" />
            </LinearLayout>






            <Button
                android:id="@+id/BTRetryDownload"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/dd1_retry"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/FLChecking"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/SVInstallLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/colorSecondarySurface"
            android:minHeight="120dp"
            android:scrollbars="vertical">

            <!-- The padding belongs to the text, not the viewport: on the
                 ScrollView it shrinks the scrollable area and the last line
                 never comes fully into view. -->
            <TextView
                android:id="@+id/TVInstallLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:fontFamily="monospace"
                android:textColor="?attr/colorSecondaryText"
                android:textIsSelectable="true"
                android:textSize="@dimen/dd1_log_size" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTCancelDownload"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="@string/cancel"
                android:visibility="gone" />

            <Button
                android:id="@+id/BTSteamSignOut"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="@string/dd1_steam_sign_out"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4" />
</LinearLayout>

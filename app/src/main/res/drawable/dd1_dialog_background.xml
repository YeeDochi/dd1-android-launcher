<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog is a card lifted over the screen: the same surface and corners, a
     hairline so it separates from the dimmed screen behind it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp"
    android:insetTop="20dp" android:insetBottom="20dp">
    <shape android:shape="rectangle">
        <solid android:color="#2D3238" />
        <stroke android:width="1dp" android:color="@color/dd1_outline" />
        <corners android:radius="16dp" />
    </shape>
</inset>

<?xml version="1.0" encoding="utf-8"?>
<!-- The action a card is for. Off, it keeps its shape as an outline, so the row of
     buttons does not change size or jump when one becomes available. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/dd1_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dd1_accent_pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The drawer slides out of the left edge, so only the edge that faces the
     screen is rounded. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSecondarySurface" />
    <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
        android:topRightRadius="24dp" android:bottomRightRadius="24dp" />
</shape>

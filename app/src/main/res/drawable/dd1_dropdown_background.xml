<?xml version="1.0" encoding="utf-8"?>
<!-- A dropdown has to look like something to press: a box with an arrow at its
     end. The spinner's own background is a lone arrow far from the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorBackground" />
            <stroke android:width="1dp" android:color="?attr/colorSecondaryText" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="12dp"
        android:width="24dp" android:height="24dp"
        android:drawable="@drawable/dd1_dropdown_arrow" />
</layer-list>

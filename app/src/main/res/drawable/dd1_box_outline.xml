<?xml version="1.0" encoding="utf-8"?>
<!-- A box inside a card - this device beside the cloud - set a step darker and
     outlined, so the two sides read as two things. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorPrimarySurface" />
    <stroke android:width="1dp" android:color="@color/dd1_outline" />
    <corners android:radius="10dp" />
</shape>
